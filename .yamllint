# yamllint configuration
extends: default

rules:
  document-start: disable
  truthy:
    allowed-values: ['true', 'false', 'on', 'off']
  line-length:
    max: 200
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
  braces:
    min-spaces-inside: 0
    max-spaces-inside: 1
  indentation:
    # GitHub Actions workflows use 2-space indentation for list items
    spaces: consistent
    indent-sequences: whatever
