      Min Color: 0; 0; 0
      Min Intensity: -1
      Name: ElevationMap
      Show Grid Lines: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /elevation_mapping_node/elevation_map
      Use Rainbow: true
      Value: true
