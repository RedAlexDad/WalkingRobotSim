# docker/Dockerfile - Multi-stage optimized для WalkingRobotSim

ARG ROS_DISTRO=jazzy
ARG BASE_IMG=osrf/ros:jazzy-desktop
ARG ROBOT_TYPE=Go2

# ============================================================
# STAGE 1: ROS Base (Редко меняется - кэшируется)
# ============================================================
FROM ${BASE_IMG} AS ros-base

# Установка базовых утилит и инструментов разработки
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    wget \
    nano \
    curl \
    ccache \
    python3-colcon-common-extensions \
    && rm -rf /var/lib/apt/lists/*

# ============================================================
# STAGE 2: ROS2 Dependencies (Иногда меняется - кэшируется)
# ============================================================
FROM ros-base AS ros-dependencies

ARG ROS_DISTRO=jazzy

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-desktop \
    ros-dev-tools \
    ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
    ros-${ROS_DISTRO}-rclcpp \
    ros-${ROS_DISTRO}-rclpy \
    ros-${ROS_DISTRO}-urdf \
    ros-${ROS_DISTRO}-xacro \
    ros-${ROS_DISTRO}-std-msgs \
    ros-${ROS_DISTRO}-angles \
    ros-${ROS_DISTRO}-ros2-control \
    ros-${ROS_DISTRO}-gz-ros2-control \
    ros-${ROS_DISTRO}-controller-manager \
    ros-${ROS_DISTRO}-hardware-interface \
    ros-${ROS_DISTRO}-pluginlib \
    ros-${ROS_DISTRO}-joint-state-publisher \
    ros-${ROS_DISTRO}-robot-state-publisher \
    ros-${ROS_DISTRO}-ros2launch \
    ros-${ROS_DISTRO}-slam-toolbox \
    ros-${ROS_DISTRO}-navigation2 \
    ros-${ROS_DISTRO}-nav2-bringup \
    ros-${ROS_DISTRO}-camera-info-manager \
    ros-${ROS_DISTRO}-rqt-robot-steering \
    ros-${ROS_DISTRO}-tf-transformations \
    ros-${ROS_DISTRO}-teleop-twist-keyboard \
    ros-${ROS_DISTRO}-ros2-controllers \
    ros-${ROS_DISTRO}-ros-gz-image \
    ros-${ROS_DISTRO}-ros-gz-bridge \
    ros-${ROS_DISTRO}-ros-gz-sim \
    ros-${ROS_DISTRO}-opennav-docking \
    ros-${ROS_DISTRO}-apriltag-ros \
    ros-${ROS_DISTRO}-apriltag-msgs \
    ros-${ROS_DISTRO}-image-proc \
    ros-${ROS_DISTRO}-image-view \
    ros-${ROS_DISTRO}-geometry-msgs \
    ros-${ROS_DISTRO}-nav2-simple-commander \
    ros-${ROS_DISTRO}-tf2-ros \
    ros-${ROS_DISTRO}-tf2 \
    ros-${ROS_DISTRO}-topic-tools \
    ros-${ROS_DISTRO}-robot-localization \
    tmux \
    tmuxinator \
    python3-colcon-common-extensions \
    ccache \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# ============================================================
# STAGE 3: Python Dependencies
# ============================================================
FROM ros-dependencies AS python-deps

RUN --mount=type=cache,target=/root/.cache/pip \
    pip3 install --no-cache-dir --break-system-packages \
    git+https://github.com/ruffsl/colcon-cache.git \
    numpy \
    scipy \
    pandas \
    PyYAML

# ============================================================
# STAGE 4: Workspace Setup and Build (Часто меняется)
# ============================================================
FROM python-deps AS workspace

ARG ROBOT_TYPE=Go2
ARG CMAKE_BUILD_TYPE=Release

WORKDIR /root/ws

# Копируем исходный код
COPY ../ /root/ws/src

# Установка зависимостей из package.xml
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    bash -c 'source /opt/ros/jazzy/setup.bash && \
    rosdep init || true && \
    rosdep update && \
    rosdep install --from-paths src \
    --ignore-src \
    --rosdistro jazzy \
    -y'

# Сборка проекта с ccache
RUN --mount=type=cache,target=/root/.ccache,sharing=locked \
    bash -c 'source /opt/ros/jazzy/setup.bash && \
    rm -rf build install log && \
    colcon cache lock && \
    colcon build \
    --symlink-install \
    --cmake-args \
    -DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE} \
    -DCMAKE_C_COMPILER_LAUNCHER=ccache \
    -DCMAKE_CXX_COMPILER_LAUNCHER=ccache \
    -DROBOT_TYPE:STRING=${ROBOT_TYPE}'

# ============================================================
# STAGE 5: Runtime Base (Минимум для production)
# ============================================================
FROM ros:jazzy-ros-core AS runtime

ARG ROS_DISTRO=jazzy

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-desktop \
    ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
    ros-${ROS_DISTRO}-ros2-controllers \
    ros-${ROS_DISTRO}-ros-gz-bridge \
    ros-${ROS_DISTRO}-ros-gz-image \
    ros-${ROS_DISTRO}-ros-gz-sim \
    ros-${ROS_DISTRO}-gz-ros2-control \
    ros-${ROS_DISTRO}-xacro \
    ros-${ROS_DISTRO}-robot-state-publisher \
    ros-${ROS_DISTRO}-robot-localization \
    ros-${ROS_DISTRO}-tf2 \
    python3-colcon-common-extensions \
    ccache \
    python3-pip \
    python3 \
    curl \
    nano \
    tmux \
    build-essential \
    cmake \
    git \
    wget \
    python3-colcon-common-extensions \
    ros-dev-tools \
    && rm -rf /var/lib/apt/lists/*

# ============================================================
# STAGE 6: Final Production Image
# ============================================================
FROM runtime AS final

ARG ROS_DISTRO=jazzy
ARG WORKSPACE_DIR=/root/ws

# Копируем только необходимые файлы из workspace stage
COPY --from=workspace ${WORKSPACE_DIR}/install ${WORKSPACE_DIR}/install
COPY --from=workspace ${WORKSPACE_DIR}/src ${WORKSPACE_DIR}/src
COPY --from=workspace ${WORKSPACE_DIR}/build ${WORKSPACE_DIR}/build
COPY --from=workspace ${WORKSPACE_DIR}/log ${WORKSPACE_DIR}/log

# Копируем welcome.sh
COPY docker/welcome.sh /welcome.sh
RUN chmod +x /welcome.sh

WORKDIR ${WORKSPACE_DIR}

# Setup shell environment
RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> ~/.bashrc && \
    echo "source ${WORKSPACE_DIR}/install/setup.bash" >> ~/.bashrc

# Обновляем entrypoint
RUN sed -i '/exec "\$@"/i source "'"${WORKSPACE_DIR}"'/install/setup.bash"' /ros_entrypoint.sh && \
    sed -i '/exec "\$@"/i umask 002' /ros_entrypoint.sh

# Metadata
LABEL maintainer="Walking Robot Team"
LABEL version="2.0"
LABEL description="ROS 2 Jazzy simulation environment for quadruped robots"

# Environment variables
ENV WORKSPACE_DIR=${WORKSPACE_DIR}
ENV ROS_DISTRO=${ROS_DISTRO}
ENV ROS_LOG_DIR=${WORKSPACE_DIR}/logs
ENV GAZEBO_MASTER_URI=http://localhost:11345
ENV GAZEBO_RESOURCE_PATH=/usr/share/gazebo-11
ENV LD_LIBRARY_PATH=/usr/local/lib:/opt/ros/${ROS_DISTRO}/lib

# Create directories
RUN mkdir -p ${ROS_LOG_DIR} && \
    mkdir -p ${WORKSPACE_DIR}/data && \
    chmod -R 755 ${ROS_LOG_DIR} ${WORKSPACE_DIR}/data

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD bash -c 'source /opt/ros/${ROS_DISTRO}/setup.bash && \
    source ${WORKSPACE_DIR}/install/setup.bash && \
    ros2 --version > /dev/null 2>&1'

CMD ["/bin/bash"]
