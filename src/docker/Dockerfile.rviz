# ============================================================
# wrs-rviz — визуализация: RViz + конфиг проекта + описания роботов.
# gazebo_sim (C++) не собирается: нужны только конфиг RViz и меши роботов.
#
# Сборка: docker build -f src/docker/Dockerfile.rviz -t wrs-rviz:latest .
# ============================================================
ARG BASE_IMG=wrs-base:latest
FROM ${BASE_IMG}

ARG ROS_DISTRO=jazzy
ENV ROS_DISTRO=${ROS_DISTRO}

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-rviz2 \
    ros-${ROS_DISTRO}-tf2-ros \
    ros-${ROS_DISTRO}-robot-state-publisher \
    && rm -rf /var/lib/apt/lists/*

WORKDIR ${WORKSPACE_DIR}

COPY src/go1_description    src/go1_description
COPY src/go2_description    src/go2_description
COPY src/gazebo_sim/rviz    /opt/wrs/rviz

RUN bash -c "source /opt/ros/${ROS_DISTRO}/setup.bash && colcon build --symlink-install --packages-select go1_description go2_description"

RUN sed -i '/exec "\$@"/i source "${WORKSPACE_DIR}/install/setup.bash"' /ros_entrypoint.sh

CMD ["rviz2", "-d", "/opt/wrs/rviz/nav2_default_view.rviz"]
