# ============================================================
# wrs-sim — симулятор: Gazebo Sim + мир + модели. Только физика и сенсоры.
# Healthcheck по /clock. Источник данных сменяем на Isaac Sim нативно.
#
# Сборка: docker build -f src/docker/Dockerfile.sim -t wrs-sim:latest .
# ============================================================
ARG BASE_IMG=wrs-base:latest
FROM ${BASE_IMG}

ARG ROS_DISTRO=jazzy
ENV ROS_DISTRO=${ROS_DISTRO}

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-ros-gz-sim \
    ros-${ROS_DISTRO}-ros-gz-bridge \
    ros-${ROS_DISTRO}-ros-gz-image \
    ros-${ROS_DISTRO}-gz-ros2-control \
    ros-${ROS_DISTRO}-ros2-control \
    ros-${ROS_DISTRO}-ros2-controllers \
    ros-${ROS_DISTRO}-controller-manager \
    && rm -rf /var/lib/apt/lists/*

WORKDIR ${WORKSPACE_DIR}

COPY src/quadropted_msgs    src/quadropted_msgs
COPY src/gazebo_sim         src/gazebo_sim
COPY src/go1_description    src/go1_description
COPY src/go2_description    src/go2_description

RUN bash -c "source /opt/ros/${ROS_DISTRO}/setup.bash && colcon build --symlink-install --packages-select gazebo_sim quadropted_msgs go1_description go2_description"

RUN sed -i '/exec "\$@"/i source "${WORKSPACE_DIR}/install/setup.bash"' /ros_entrypoint.sh

ENV GZ_SIM_RESOURCE_PATH=${WORKSPACE_DIR}/install/gazebo_sim/share/gazebo_sim/models
ENV GAZEBO_MODEL_PATH=${WORKSPACE_DIR}/install/gazebo_sim/share/gazebo_sim/models

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD bash -c 'source /opt/ros/${ROS_DISTRO}/setup.bash && ros2 topic list | grep -q "^/clock$" || exit 1'

CMD ["ros2", "launch", "gazebo_sim", "launch_sim.py"]
