<!-- вставки <model> в .world (по одному сценарию) -->

    <model name="s1_flat">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <heightmap>
              <uri>model://terrain/s1_flat.png</uri>
              <size>20.0 20.0 0.010</size>
              <pos>0 0 0</pos>
            </heightmap>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <heightmap>
              <uri>model://terrain/s1_flat.png</uri>
              <size>20.0 20.0 0.010</size>
              <pos>0 0 0</pos>
              <texture><diffuse>0.6 0.6 0.5</diffuse></texture>
              <blend><min_height>0.0</min_height><fade_dist>0.1</fade_dist></blend>
            </heightmap>
          </geometry>
        </visual>
      </link>
    </model>

