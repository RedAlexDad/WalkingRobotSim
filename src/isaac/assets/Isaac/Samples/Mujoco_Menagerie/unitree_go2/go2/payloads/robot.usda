#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.2.0"
    }
    defaultPrim = "go2"
    doc = """Generated from Composed Stage of root layer /tmp/tmply3yqgyt/go2.usdc


Generated from Composed Stage of root layer /tmp/mjcf_import_go2_trnys728/usdex_go2/go2.usdc


Generated from Composed Stage of root layer /tmp/mjcf_import_go2_trnys728/temp_go2/go2.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "go2" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </go2/Geometry/base/FL_hip/FL_hip_joint>,
        </go2/Geometry/base/FR_hip/FR_hip_joint>,
        </go2/Geometry/base/RL_hip/RL_hip_joint>,
        </go2/Geometry/base/RR_hip/RR_hip_joint>,
        </go2/Geometry/base/FL_hip/FL_thigh/FL_thigh_joint>,
        </go2/Geometry/base/FL_hip/FL_thigh/FL_calf/FL_calf_joint>,
        </go2/Geometry/base/FR_hip/FR_thigh/FR_thigh_joint>,
        </go2/Geometry/base/FR_hip/FR_thigh/FR_calf/FR_calf_joint>,
        </go2/Geometry/base/RL_hip/RL_thigh/RL_thigh_joint>,
        </go2/Geometry/base/RL_hip/RL_thigh/RL_calf/RL_calf_joint>,
        </go2/Geometry/base/RR_hip/RR_thigh/RR_thigh_joint>,
        </go2/Geometry/base/RR_hip/RR_thigh/RR_calf/RR_calf_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </go2/Geometry/base>,
        </go2/Geometry/base/FL_hip>,
        </go2/Geometry/base/FL_hip/FL_thigh>,
        </go2/Geometry/base/FL_hip/FL_thigh/FL_calf>,
        </go2/Geometry/base/FR_hip>,
        </go2/Geometry/base/FR_hip/FR_thigh>,
        </go2/Geometry/base/FR_hip/FR_thigh/FR_calf>,
        </go2/Geometry/base/RL_hip>,
        </go2/Geometry/base/RL_hip/RL_thigh>,
        </go2/Geometry/base/RL_hip/RL_thigh/RL_calf>,
        </go2/Geometry/base/RR_hip>,
        </go2/Geometry/base/RR_hip/RR_thigh>,
        </go2/Geometry/base/RR_hip/RR_thigh/RR_calf>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "FL_hip" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "FL_thigh" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "FL_calf" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "FL_calf_joint" (
                            prepend apiSchemas = ["IsaacJointAPI"]
                        )
                        {
                        }
                    }

                    over "FL_thigh_joint" (
                        prepend apiSchemas = ["IsaacJointAPI"]
                    )
                    {
                    }
                }

                over "FL_hip_joint" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }
            }

            over "FR_hip" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "FR_thigh" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "FR_calf" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "FR_calf_joint" (
                            prepend apiSchemas = ["IsaacJointAPI"]
                        )
                        {
                        }
                    }

                    over "FR_thigh_joint" (
                        prepend apiSchemas = ["IsaacJointAPI"]
                    )
                    {
                    }
                }

                over "FR_hip_joint" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }
            }

            over "RL_hip" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "RL_thigh" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "RL_calf" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "RL_calf_joint" (
                            prepend apiSchemas = ["IsaacJointAPI"]
                        )
                        {
                        }
                    }

                    over "RL_thigh_joint" (
                        prepend apiSchemas = ["IsaacJointAPI"]
                    )
                    {
                    }
                }

                over "RL_hip_joint" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }
            }

            over "RR_hip" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "RR_thigh" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "RR_calf" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "RR_calf_joint" (
                            prepend apiSchemas = ["IsaacJointAPI"]
                        )
                        {
                        }
                    }

                    over "RR_thigh_joint" (
                        prepend apiSchemas = ["IsaacJointAPI"]
                    )
                    {
                    }
                }

                over "RR_hip_joint" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }
            }
        }
    }
}

