# ── Quadropted Controller — Doxygen Configuration ─────────────────

DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "@PROJECT_NAME@"
PROJECT_NUMBER         = @PROJECT_VERSION@
PROJECT_BRIEF          = "Quadruped robot controller — C++ implementation"
OUTPUT_DIRECTORY       = @CMAKE_CURRENT_BINARY_DIR@/doxygen
INPUT                  = @CMAKE_CURRENT_SOURCE_DIR@/include @CMAKE_CURRENT_SOURCE_DIR@/doc/mainpage.md
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.h *.md
USE_MDFILE_AS_MAINPAGE = @CMAKE_CURRENT_SOURCE_DIR@/doc/mainpage.md
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
SEARCHENGINE           = YES
SORT_BRIEF_DOCS        = YES
ALPHABETICAL_INDEX     = YES
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_EXTRA_STYLESHEET  = @CMAKE_CURRENT_SOURCE_DIR@/doc/custom.css
HTML_EXTRA_FILES       = @CMAKE_CURRENT_SOURCE_DIR@/doc/favicon.svg
HTML_HEADER            =
HTML_FOOTER            =
PROJECT_LOGO           = @CMAKE_CURRENT_SOURCE_DIR@/doc/favicon.svg
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
QUIET                  = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = "DOXYGEN_SHOULD_SKIP_THIS"
SKIP_FUNCTION_MACROS   = NO
TOC_INCLUDE_HEADINGS   = 3
HTML_COLORSTYLE_HUE    = 209
HTML_COLORSTYLE_SAT    = 255
HTML_COLORSTYLE_GAMMA  = 80
